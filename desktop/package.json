{
  "name": "nordico-informes-desktop",
  "productName": "Nordico Informes",
  "version": "1.1.0",
  "private": true,
  "description": "Nórdico Ingenieros — Informes Técnicos (escritorio)",
  "author": "Nórdico Ingenieros",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win --x64",
    "release:win": "electron-builder --win --x64 --publish always"
  },
  "build": {
    "appId": "pe.nordico.informes",
    "files": [
      "main.cjs",
      "offline.html",
      "build/icon.png"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Nordico Informes",
      "artifactName": "Nordico-Informes-Setup-${version}.exe"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "1234566778899",
        "repo": "servicios-ingenieros",
        "releaseType": "release"
      }
    ]
  },
  "devDependencies": {
    "electron": "^44.10.0",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
